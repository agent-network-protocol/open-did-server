# 复制为 .env 后由进程环境加载。本文件不含密钥。
# 服务不读取 .env 文件本身；启动前导出这些变量，或由 systemd Environment= 注入。

# 数据目录。数据库、高水位文件和示例身份都在这里，不要提交。
OPEN_DID_DATA_DIR=./data

# 监听地址。本地模式保持回环，不要改成 0.0.0.0，除非明确要接受局域网连接。
OPEN_DID_HOST=127.0.0.1
OPEN_DID_PORT=8765

# DID authority。必须是合法 DNS 名，不能写成 IP，也不能把 HTTP 监听端口写进 DID。
PUBLIC_DID_DOMAIN=example.test
PUBLIC_DID_PORT=443

# Handle Provider 域名。与 PUBLIC_DID_DOMAIN 相同时才接受 WBA Handle。
HANDLE_PROVIDER_DOMAIN=example.test

# 客户端实际签名的服务根 URL，不含末尾斜杠。本地演示用 http://回环:端口。
REQUEST_BASE_URL=http://127.0.0.1:8765

# 1 为本地演示。0 为正式模式：REQUEST_BASE_URL 必须是 https，且拒绝解析覆盖。
LOCAL_DEMO_MODE=1

# 只在本地演示中由客户端使用。服务端启动时若正式模式设置了它会拒绝启动。
# DID_RESOLUTION_BASE_URL_OVERRIDE=http://127.0.0.1:8765

# 反向代理来源。留空则忽略全部 X-Forwarded-*。示例：127.0.0.1/32
TRUSTED_PROXY_CIDRS=

# 根 DID 方法。留空表示不发布 did:wba:example.test 或 did:web:example.test 根文档。
ROOT_DID_METHOD=
